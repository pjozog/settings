#!/usr/bin/env bash

# Capture a screenshot via a wofi chooser (window / region / desktop, with an
# optional delay and cursor) and pipe it straight into Gradia for annotation.
#
# Gradia reads a PNG from stdin and opens directly in its editor, so this gives
# us the "which mode / how much delay / include cursor" popup that Gradia's own
# portal-driven button can't provide under sway.
#
# Companion to `wayland-screenshot`, which saves to ~/Pictures instead.

set -euo pipefail

delay="${SCREENSHOT_DELAY:-0}"
cursor_flag=()

if [[ $# -eq 0 ]]; then
    # Select screenshot mode.
    selection=$(
        printf '%s\n' \
            '🪟  Window' \
            '✂️  Region' \
            '🖥️  Entire desktop' |
        wofi --dmenu --prompt "Select mode" --normal-window --width 300 --height 300
    ) || exit 0

    case "$selection" in
        "🪟  Window")         mode=window ;;
        "✂️  Region")         mode=rect ;;
        "🖥️  Entire desktop") mode=desktop ;;
        *) exit 0 ;;
    esac

    # Enter delay.
    entered_delay=$(
        wofi --dmenu \
            --prompt "Enter delay secs (default: $delay)"  --normal-window  --width 300 --height 300 \
            </dev/null
    ) || exit 0

    delay="${entered_delay:-$delay}"

    # Include cursor?
    cursor_choice=$(
        printf '%s\n' \
            '🚫  No cursor' \
            '🖱️  Include cursor' |
        wofi --dmenu --prompt "Cursor" --normal-window --width 300 --height 300
    ) || exit 0

    case "$cursor_choice" in
        "🖱️  Include cursor") cursor_flag=(-c) ;;
        *) cursor_flag=() ;;
    esac

    # Let wofi fully close (and the pointer/key release from picking the last
    # menu entry get delivered) before slurp grabs input. Otherwise slurp can
    # receive that stray release event and exit with "selection cancelled".
    sleep 0.3
else
    mode="$1"
    delay="${2:-$delay}"
    # Optional third arg: "cursor" (or 1/yes/true) to include the pointer.
    case "${3:-}" in
        cursor|1|yes|true) cursor_flag=(-c) ;;
    esac
fi

# Validate delay.
if [[ ! "$delay" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
    echo "Invalid delay: $delay" >&2
    exit 1
fi

# Select geometry BEFORE sleeping.
case "$mode" in
    window)
        geometry=$(
            swaymsg -t get_tree |
            jq -r '
                .. | objects |
                select(.pid? and .visible? == true) |
                .rect as $r |
                (.deco_rect.height // 0) as $titlebar |
                "\($r.x),\($r.y - $titlebar) \($r.width)x\($r.height + $titlebar)"
            ' |
            slurp -r
        ) || exit 0
        ;;

    rect)
        geometry=$(slurp) || exit 0
        ;;

    desktop)
        ;;

    *)
        echo "Usage: $0 [window|rect|desktop] [delay] [cursor]" >&2
        exit 1
        ;;
esac

# NOW wait, with geometry already selected.
sleep "$delay"

# Capture to stdout (PNG) and hand it to Gradia for annotation.
case "$mode" in
    window|rect)
        grim "${cursor_flag[@]}" -g "$geometry" - | gradia
        ;;
    desktop)
        grim "${cursor_flag[@]}" - | gradia
        ;;
esac
